# Copy this file to .env.local and fill in your own values.
# Without a key the app still works in demo mode (saved sample answers).

# Your Anthropic API key from https://platform.claude.com (starts with sk-ant-)
ANTHROPIC_API_KEY=

# Optional: which Claude model to use
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: how many live answers one visitor (IP address) can get per day on the shared key
DAILY_LIMIT_PER_IP=20
